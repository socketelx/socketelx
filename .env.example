# Copy to .env and edit:  cp .env.example .env
# Use it with Docker:     docker run --env-file .env -p 6001:6001 ghcr.io/socketelx/socketelx
# Or Compose:             env_file: .env
# Never commit your real .env. Every variable is optional except the three secrets below.

# --- Your app (required in practice) ---
SOCKETELX_APP_ID=my-app-id
SOCKETELX_APP_KEY=my-app-key
# Long random value, e.g.  openssl rand -hex 32
SOCKETELX_APP_SECRET=change-me-to-a-long-random-secret

# Several apps instead of the three above (JSON, one line):
# SOCKETELX_APPS=[{"id":"chat","key":"chat-key","secret":"...","allowed_origins":["https://chat.example.com"]}]

# --- Network ---
PORT=6001
# Only these websites may open a WebSocket (comma-separated; default: all)
# SOCKETELX_ALLOWED_ORIGINS=https://chat.example.com,*.example.org
# Serve HTTPS/WSS directly (otherwise terminate TLS at a proxy)
# SOCKETELX_TLS_CERTFILE=/certs/fullchain.pem
# SOCKETELX_TLS_KEYFILE=/certs/privkey.pem

# --- Webhooks ---
# SOCKETELX_WEBHOOK_URL=https://example.com/pusher/webhooks
# SOCKETELX_WEBHOOK_RETRIES=3
# Keep failed webhooks across restarts (mount a volume here)
# SOCKETELX_WEBHOOK_QUEUE_PATH=/data/webhooks

# --- Limits (all off unless set) ---
# SOCKETELX_ENABLE_CLIENT_MESSAGES=true
# SOCKETELX_BATCH_LIMIT=10
# SOCKETELX_REST_RATE_LIMIT=100
# SOCKETELX_CLIENT_EVENT_RATE_LIMIT=10
# SOCKETELX_MAX_CONNECTIONS=10000
# SOCKETELX_MAX_CONNECTIONS_PER_IP=20
# Behind a proxy/tunnel, read the real client IP from this header
# SOCKETELX_CLIENT_IP_HEADER=cf-connecting-ip

# --- Metrics ---
# SOCKETELX_METRICS=true
# SOCKETELX_METRICS_TOKEN=another-long-random-value

# --- Several servers ---
# Redis:
# SOCKETELX_REDIS_URL=redis://redis:6379
# Redis Cluster: point the URL at any one cluster node and turn this on.
# SOCKETELX_REDIS_CLUSTER=true
# SOCKETELX_REDIS_CLUSTER_NODES=redis-2:6379,redis-3:6379
# Or experimental Erlang clustering (no Redis):
# SOCKETELX_CLUSTER=erlang
# SOCKETELX_CLUSTER_DNS=socketelx.internal
# RELEASE_COOKIE=another-long-random-value
